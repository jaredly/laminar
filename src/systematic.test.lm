fn head(~x) ~{
    match ~x {
        [h, ...rest] -> @(
            Some(h), fn (opt) (
                match opt {
                    None -> [];
                    Some(h) -> [h, ...rest]
                }
            )
        )
        h -> @(
            None, fn (opt) (
                match opt {
                    None -> h;
                    Some(h) -> [h]
                }
            )
        )
    }
}

