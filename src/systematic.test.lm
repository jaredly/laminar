fn head(~x) ~{
    match ~x {
        [h, ...rest] -> {
            let v = ~heap(Some(h))
            @(
                v, fn () {
                    match v {
                        None -> {x := []}
                        Some(h) -> {x := [h, ...rest]}
                    }
                }
            )
        }
        [] -> {
            let v = ~heap(None)
            @(
                v, fn () {
                    match v {
                        None -> {x := []}
                        Some(h) -> {x := [h]}
                    }
                }
            )
        }
    }
}

