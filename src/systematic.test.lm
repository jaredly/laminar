fn head(~x) ~{
    match ~x {
        [h, ...rest] -> @(
            Some(h), fn (opt) (
                match opt {
                    None -> rest;
                    Some(h) -> [h, ...rest]
                }
            )
        )
        [] -> @(
            None, fn (opt) (
                match opt {
                    None -> [];
                    Some(h) -> [h]
                }
            )
        )
    }
}

