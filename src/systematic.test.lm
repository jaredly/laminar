                        Some(h6) -> [h6, ...rest4]
                    }
                )
            )
            h7 -> (
                None(), (opt8)=>(
                    match opt8 {
                        None() -> h7
                        Some(h9) -> [h9]
                    }
                )
            )
        }
    )
}{
    (
