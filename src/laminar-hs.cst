@config {
    reserved: [let lens ~ <- = := case :: => _]
}

File {
    ["\n" ...items:FileItem] -> items
    item:FileItem -> [item]
}

FileItem {
    [" " name:id "::" ...ann:*Type] -> ({type: "annotation", name, ann})
    [" " name:id ...args:Pat "=" ...term:*Term] -> ({type: "declaration", name, args, term})
    linear:Linear -> ({type: "value", value})
}

Pat {
    "_" -> ({type: "drop"})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" inner:Pat] -> ({type: "lens", inner})
    ["" name:id ["(," ...args:Pat]] -> ({type: "constructor", name: name.text, args})
    ["(," ...items:Pat] -> ({type: "tuple", items})
    ["("] -> ({type: "tuple", items: []})
}

Type {
    [" " arg:Type "->" body:Type] -> ({type: "fn", args: [arg], body})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" left:Type] -> ({type: "lens", left})
    ["" left:Type "/" right:Type] -> ({type: "lens", left, right})
    ["(," ...items:Type] -> ({type: "tuple", items})
    // [" " ["(," ...args:Type] "=>" body:Type] -> ({type: "fn", args, body})
}

Term {
    [" " one:Term] -> one
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    ["{" ["" "~" ...lens:*Lens]] -> ({type: "lens", lens})
    linear:Linear -> linear
}

Lens {
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" one:Lens] -> one
    ["" fn:Linear ["(," ...args:Term]] -> ({type: "apply", fn, args})
    ["(," ...items:Lens] -> ({type: "tuple", items})
    ["{" one:Lens] -> one
    ["("] -> ({type: "tuple", items: []})
    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Lens] -> ({type: "let", pat, value, body})
    ["{\n" [" " "lens" pat:Pat "<-" ...value:*Linear] ...body:*Linear] -> ({type: "aslens", pat, value, body})
    ["{\n" one:Lens] -> one
    ["{\n" value:Term ...body:*Lens] -> ({type: "let", pat: {type: "drop"}, value, body})
}

import {partition} from "./laminar-helpers.ts"

Op {
    re"^[+-]$"
}

Linear {
    re"^[0-9]+$" -> ({type: "const", value: +(node as Id).text, loc: node.loc})
    re"true|false" -> ({type: "const", value: (node as Id).text === "true", loc: node.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["\"" text:id] -> ({type: "string", head: text.text, interp: [], loc: node.loc})
    ["" one:Linear] -> one
    ["" fn:Op ...arg:*Linear] -> ({type: "apply", fn, args: [arg],loc:node.loc})
    ["" target:Linear ...suffixes:**LinearOps] -> handleSuffixes(target, suffixes)
    ["(," ...items:Linear] -> ({type: "tuple", items,loc:node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["\"" head:id ...interp:**LinearInterp] -> ({type: "string", head: head.text, interp,loc:node.loc})
    [" " "match" value:Linear ["{" ...cases:LinearCase]] -> ({type: "case", value, cases,loc:node.loc})

    /* Would be nice to have an Ann() fn to allow reducing these cases by half */
    [" " "fn" [":" ["" name:id ["(," ...args:FnArg]] ann:Type] body:Term] -> ({type: "fn", name: name.text, args, ann, body,loc:node.loc})
    [" " "fn" ["" name:id ["(," ...args:FnArg]] body:Term] -> ({type: "fn", name: name.text, args, body,loc:node.loc})
    [" " "fn" [":" ["(," ...args:FnArg] ann:Type] body:Term] -> ({type: "fn", args, ann, body,loc:node.loc})
    [" " "fn" ["(," ...args:FnArg] body:Term] -> ({type: "fn", args, body,loc:node.loc})
    [" " lens:Lens ":=" ...value:*Linear] -> ({type: "assign", lens, value,loc:node.loc})
    [" " left:Linear ...right:(op:op right:Linear)] -> partition(left, right)
    [" " one:Linear] -> one
    ["\n" one:Linear] -> one

    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["{" one:Linear] -> one
    ["{\n" one:Linear] -> one
    ["{\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop"}, value, body,loc:node.loc})
    ["\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop"}, value, body,loc:node.loc})
}

LinearOps {
    // ["" "." attr:id] -> ({type: "attr", attr: attr.text})
    // ["" ["[" index:Linear]] -> ({type: "index", index})
    ["" ["(," ...args:Term]] -> ({type: "apply", args})
}

function handleSuffixes(head: Linear, suffixes: LinearOps[]): Linear {
    return suffixes.reduce((head, suffix): Linear => {
        switch (suffix.type) {
            // case "attr": return {type: "attr", target: head, attr: suffix.attr,loc:head.loc}
            // case "index": return {type: "index", index: suffix.index, target: head,loc:head.loc}
            case "apply": return {type: "apply", fn: head, args: suffix.args,loc:head.loc}
        }
        throw new Error("bad suffix" + JSON.stringify(suffix))
    }, head)
}

/*


Ok what about something like:
->

NO actually we can just be normal. just call a helper fn.

partition(left: expr, rights: {op: Id, right: expr}[], (op, left, right) -> expr) -> expr

*/

FnArg {
    pat:Pat -> ({pat})
    [":" pat:Pat typ:Type] -> ({pat, typ})
}

LinearCase {
    [" " pat:Pat ...body:*Linear] -> ({pat, body})
}

LinearInterp {
    ["\"" value:Linear tail:id] -> ({value, tail: tail.text})
}


/*
Linear {
    ["" ...children:*] -> parseOp(children)
    ["\"" head:id ...interp:(value:Linear tail:id)] -> {head: head.text, interp}
    ["{" child:Linear] -> child
    ["{" ...block:*Block] -> block
    ["("] -> ({type: 'const', value: null})
    ["(" one:Linear] -> one
    ["(" ...items:Linear] -> ({type: "tuple", items})
    [" " one:Linear] -> one
    [" " "match" value:Linear ["{" ...cases:LinearCase]] -> ({type: "case", value, cases})
    // if the fncall has a no binding, then the bindings are splatted in.
    [" " "fn" Ann(["(" ...args:FnArg]) body:FnBody] -> ({type: "fn", args, ann, body})
    [" " lens:Lens "<-" ...value:*Linear] -> ({type: "assign", lens, value})
    [" " left:Linear ...right:(op:op right:Linear)] -> partition(left, right)
}

FnBody {
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    ["{" one:Term] -> one
    ["{" ...block:*Block] -> block
    one:Linear -> Linear
}

// A fn allows optional bindings
Ann(inner) {
    [": " inner ann:Type]
    inner
}

LinearCase {
    [" " pat:Pat "=>" ...body:*Linear] -> ({pat, body})
}

Block {
    ["{" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Block] -> ({type: "let", pat, value, body})
    ["{" value:Term ...body:*Block] => ({type: "let", pat: {type: "tuple", items: []}, value, body})
}
*/
