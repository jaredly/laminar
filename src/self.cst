@config {
}

File {
    ["\n" ...items:FileItem] -> items
}

FileItem {
    rule:RawRule -> ({ type: "rule", rule })
    [" " "function" ...rest:*any] -> ({ type: "function", rest })
    [" " "const" ...rest:*any] -> ({ type: "const", rest })
    [" " "import" ...rest:*any] -> ({ type: "import", rest })
    [" " ["" "@" "config"] ["{\n" ...config:ConfigItem]] -> ({type: "config", values: Object.fromEntries(config)})
    [" " ["" "@" "config"] ["{"]] -> ({type: "config", values: {}})
}

ConfigItem:[string, ConfigValue] {
    [":" name:id value:ConfigValue] -> [name.text, value]
}

ConfigValue {
    ["[ " ...values:ConfigValue] -> values
    id:id -> id.text
    op:op -> op.text
    num:re"^[0-9]+$" -> +num.text
    ["\"" text:id] -> text.text
}

RawRule {
    [" " name:RuleName ["{" ["\n" ...options:RawOption]]] -> ({ name, options })
    [" " name:RuleName ["{" option:RawOption]] -> ({ name, options: [option] })
}

RuleName:{name:Id,ann?:Node} {
    name:id -> ({name})
    [":" name:id ann:any] -> ({name, ann})
}

RawOption {
    [" " pat:Pat "->" ...res:*any] -> ({ pat, res })
    ["\"" text:id] -> ({ pat: { type: "literal", text } })
    ["" "re" ["\"" raw:id]] -> ({ pat: { type: "regexp", regexp: new RegExp(raw.text) } })
}

function parseList(kind: Id, items: Pat[]): Pat {
    if ("{[(".includes(kind.text[0])) {
        return {
            type: "wrapper",
            kind: { ...kind, text: kind.text[0] },
            child: { type: "list", kind: { ...kind, text: kind.text[1] }, items },
        };
    }
    return { type: "list", kind, items };
}

Pat {
    ["\"" text:id] -> ({ type: "literal", text })
    [":" name:id rule:id] -> ({ type: "rule", name, rule })
    [":" name:id ["" "re" ["\"" raw:id]]] -> ({ type: "rule", name, rule: {type: "regex", rx: new RegExp(raw.text)} })
    ["[" [" " ["\"" kind:WrapperKind] child:Pat]] -> ({ type: "wrapper", kind, child })
    ["[" [" " ["\"" kind:ListKind] ...items:Pat]] -> parseList(kind, items)
    ["[" ["\"" kind:WrapperKind]] -> ({type: "wrapper", kind})
    [":" ["" "..." name:id] ["" "*" rule:id]] -> ({ type: "rest", name, rule, multi: !1 })
    [":" ["" "..." name:id] ["" "**" rule:id]] -> ({ type: "rest", name, rule, multi: !0 })
    [":" ["" "..." name:id] rule:id] -> ({ type: "many", name, rule })
    [":" ["" "..." name:id] ["(" [" " ...items:Pat]]] -> ({ type: "many-items", name, items })
    ["" "re" ["\"" raw:id]] -> ({ type: "regexp", regexp: new RegExp(raw.text) })
}

WrapperKind:Id {
    "{"
    "("
    "["
}

ListKind:Id {
    re"[{([][ ,;:\n]"
    ","
    ";"
    ""
    " "
    ":"
    "\""
    "\n"
}
