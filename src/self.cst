File {
    ["\n" ...items:FileItem] -> items
}

FileItem {
    rule:RawRule -> ({type: 'rule', rule})
    [" " "function" ...rest:*any] -> ({type: "function", rest})
    [" " "const" ...rest:*any] -> ({type: "const", rest})
}

RawRule {
    [" " name:id ["{\n" ...options:RawOption]] -> ({name, options})
}

RawOption {
    [" " pat:Pat "->" ...res:*any] -> ({pat, res})
    ["\"" text:id] -> ({pat: {type: 'literal', text}})
    ["" "re" ["\"" raw:id]] -> ({pat: {type: "regexp", regexp: new RegExp(raw.text)}})
}

function parseList(kind: Id, items: Pat[]): Pat {
    if ("{[(".includes(kind.text[0])) {
        return {
            type: 'wrapper',
            kind: { ...kind, text: kind.text[0] },
            child: { type: 'list', kind: { ...kind, text: kind.text[1] }, items },
        };
    }
    return { type: 'list', kind, items };
}

Pat {
    ["\"" text:id] -> ({type: "literal", text})
    [":" name:id rule:id] -> ({type: "rule", name, rule})
    ["[ " ["\"" kind:WrapperKind] child:Pat] -> ({type: "wrapper", kind, child})
    ["[ " ["\"" kind:ListKind] ...items:Pat] -> parseList(kind, items)
    [":" ["" "..." name:id] ["" "*" rule:id]] -> ({type: "rest", name, rule, multi: false})
    [":" ["" "..." name:id] ["" "**" rule:id]] -> ({type: "rest", name, rule, multi: true})
    [":" ["" "..." name:id] rule:id] -> ({type: "many", name, rule})
    [":" ["" "..." name:id] ["( " ...items:Pat]] -> ({type: "many-items", name, items})
    ["" "re" ["\"" raw:id]] -> ({type: "regexp", regexp: new RegExp(raw.text)})
}

WrapperKind {
    "{"
    "("
    "["
}

ListKind {
    re"[{([][ ,;:\n]"
    ""
    " "
    ","
    ";"
    ":"
    "\""
    "\n"
}
