@config {
    reserved: [inject let lens mut linear not if then else ~ <- = := case :: => _ @]
}

File {
    ["\n" ...items:FileItem] -> items
    item:FileItem -> [item]
}

FileItem {
    [" " name:id "::" ...ann:*Type] -> ({type: "decl", name, ann, loc: node.loc})
    decl:TypeDecl -> decl
    linear:Linear -> linear
}

TypeDecl {
    [" " "type" name:id "=" ...alias:*Type] -> ({type: "type-alias", name, alias, loc: node.loc})
    [" " "type" ["" name:id ["(," ...args:id]] "=" ...alias:*Type] -> ({type: "type-alias", name, args, alias, loc: node.loc})
    [" " "type" name:id ["{\n" ...items:TypeConstr]] -> ({type: "union", name, items, loc: node.loc})
    [" " "type" ["" name:id ["(," ...args:id]] ["{\n" ...items:TypeConstr]] -> ({type: "union", name, args, items, loc: node.loc})
    [" " "type" "linear" name:id "=" ...alias:*Type] -> ({type: "type-alias", name, alias, linear: true, loc: node.loc})
    [" " "type" "linear" ["" name:id ["(," ...args:id]] "=" ...alias:*Type] -> ({type: "type-alias", name, args, alias, linear: true, loc: node.loc})
    [" " "type" "linear" name:id ["{\n" ...items:TypeConstr]] -> ({type: "union", name, items, linear: true, loc: node.loc})
    [" " "type" "linear" ["" name:id ["(," ...args:id]] ["{\n" ...items:TypeConstr]] -> ({type: "union", name, args, items, linear: true, loc: node.loc})
}

TypeConstr {
    name:re"^[A-Z]" -> ({name, loc: node.loc})
    ["" name:re"^[A-Z]" ["(," ...args:Type]] -> ({name, args, loc: node.loc})
}

function pcons(items:Pat[], loc:number) {
    let last = items[items.length - 1]
    for (let i=items.length-2;i>=0;i--) {
        last = {type:"constructor",name:"cons",args:[items[i], last],loc}
    }
    return last
}

function econs(items:Linear[], loc:number) {
    let last = items[items.length - 1]
    for (let i=items.length-2;i>=0;i--) {
        last = {type:"constructor",name:"cons",args:[items[i], last],loc}
    }
    return last
}

Pat {
    "_" -> ({type: "drop", loc: node.loc})
    bool:re"true|false" -> ({type: "bool", loc: node.loc, value: bool.text === 'true'})
    ["" one:re"^[0-9]+$" "." two:re"^[0-9]+$"] -> ({type: "number", value: +(one.text + '.' + two.text), loc: node.loc})
    re"^[0-9]+$" -> ({type: "number", value: +(node as Id).text, loc: node.loc})
    name:re"^[A-Z]" -> ({type: "constructor", name: name.text, args: [], loc: node.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" inner:Pat] -> ({type: "lens", inner, loc: node.loc})
    ["" name:id ["(," ...args:Pat]] -> ({type: "constructor", name: name.text, args, loc: node.loc})
    ["{," ...fields:PatField] -> precord(fields, node.loc)
    ["{" one:PatField] -> precord([one], node.loc)
    ["(," ...items:Pat] -> items.length === 1 ? items[0] : ({type: "tuple", items, loc: node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["["] -> ({type: "constructor", name: "nil",args:[], loc: node.loc})
    ["[," ...items:Pat] -> pcons([...items, ({type: "constructor", name: "nil",args:[], loc: node.loc})], node.loc)
    ["[," ...items:Pat ["" "..." ...tail:*Pat]] -> pcons([...items, tail], node.loc)
    ["\"" text:id] -> ({type: "string", text: text.text, loc: node.loc})
    ["\""] -> ({type: "string", text: "", loc: node.loc})
    ["" one:Pat] -> one
    // [":" head:id tail:id] -> ({type: "pcons", head, tail, loc: node.loc})
    // ["[," ...items:Pat] -> ({type: "list", items, tail: null, loc: node.loc})
    // ["[," ...items:Pat ["" "..." tail:Pat]] -> ({type: "list", items, tail, loc: node.loc})
}

TypeField {
    // `{f: (a) => b}` lexes with `:` binding first, so the arrow holds the field.
    [" " [":" name:id ["(," ...args:Type]] "=>" ...body:*Type] -> ({name: name.text, type: {type: "fn", args, body} as Type, loc: node.loc})
    [" " [":" name:id ["(," ...args:Type]] ["" "=" needs:Needs ">"] ...body:*Type] -> ({name: name.text, type: {type: "fn", args, needs, body} as Type, loc: node.loc})
    // Likewise `{f: mut a}` lexes with `mut` next to the name.
    [" " [":" name:id "once"] ...value:*Type] -> ({name: name.text, type: kinded(value, "once"), loc: node.loc})
    [" " [":" name:id "linear"] ...value:*Type] -> ({name: name.text, type: kinded(value, "linear"), loc: node.loc})
    [" " [":" name:id "mut"] ...value:*Type] -> ({name: name.text, type: mutType(value, node.loc), loc: node.loc})
    ["" "..." "_"] -> ({rest: {type: "id", text: "_", loc: node.loc} as Id, loc: node.loc})
    ["" "..." rest:id] -> ({rest, loc: node.loc})
    [":" name:id type:Type] -> ({name: name.text, type, loc: node.loc})
}

// What a function needs, between `={` and `}>`: record aliases, one row variable, or fields.
Needs {
    ["{"] -> ([] as NeedsItem[])
    ["{," ...items:NeedsItem] -> items
    ["{" one:NeedsItem] -> [one]
}

NeedsItem {
    field:TypeField -> field
    type:Type -> ({include: type, loc: node.loc})
}

// `mut ~A` and `mut A/B` are owned lenses; `mut` on anything else says who owns a value.
function mutType(value: Type, loc: number): Type {
    return value.type === "lens" && !value.owned ? {...value, owned: true} : {type: "mut", value, loc}
}

function kinded(value: Type, kind: "once" | "linear"): Type {
    if (value.type !== "fn" || value.kind) throw new Error("`" + kind + "` is written before a function type, as in `" + kind + " () => a`")
    return {...value, kind}
}

function trecord(items: TypeField[], loc: number): Type {
    const last = items[items.length - 1]
    const rest = last && "rest" in last ? last.rest : undefined
    const fields = rest ? items.slice(0, -1) : items
    if (fields.some((f) => "rest" in f)) throw new Error("`...` must be the last part of a record type")
    return {type: "record", fields: fields as Extract<TypeField, {name: string}>[], ...(rest ? {rest} : {}), loc}
}

function precord(items: PatField[], loc: number): Pat {
    const last = items[items.length - 1]
    const rest = last && "rest" in last ? last.rest : undefined
    const fields = rest ? items.slice(0, -1) : items
    if (fields.some((f) => "rest" in f)) throw new Error("`...rest` must be the last part of a record pattern")
    return {type: "record", fields: fields as Extract<PatField, {name: string}>[], ...(rest ? {rest} : {}), loc}
}

PatField {
    ["" "..." rest:Pat] -> ({rest, loc: node.loc})
    [":" name:id pat:Pat] -> ({name: name.text, pat, loc: node.loc})
    name:id -> ({name: name.text, pat: {type: "id", text: name.text, loc: node.loc} as Pat, loc: node.loc})
}

RecordField {
    [":" name:id value:Linear] -> ({kind: "field", op: "extend", name: name.text, value, loc: node.loc})
}

// One part of a record: `...r`, `l: v`, `l = v`, `-l` or `-l = v`.
RecordItem {
    ["" "..." head:Linear ...suffixes:**LinearOps] -> ({kind: "spread", value: handleSuffixes(head, suffixes), loc: node.loc})
    [" " ["" "-" name:id] "=" ...value:*Linear] -> ({kind: "field", op: "replace", name: name.text, value, loc: node.loc})
    ["" "-" name:id] -> ({kind: "field", op: "remove", name: name.text, loc: node.loc})
    [" " name:id "=" ...value:*Linear] -> ({kind: "field", op: "update", name: name.text, value, loc: node.loc})
    field:RecordField -> field
}

// A record starts with one of these, since no other part applies to an empty record. So `{-x}`
// and `{x = 1}` stay blocks.
SoleRecordItem {
    ["" "..." head:Linear ...suffixes:**LinearOps] -> ({kind: "spread", value: handleSuffixes(head, suffixes), loc: node.loc})
    field:RecordField -> field
}

// Only fields with names and values make a literal; anything else is an update.
function erecord(items: RecordItem[], loc: number): Linear {
    if (items.some((i) => i.kind === "spread" || i.op !== "extend")) return {type: "update", items, loc}
    return {type: "record", fields: items.map((i) => {
        const {name, value, loc} = i as RecordItem & {name: string, value: Linear}
        return {name, value, loc}
    }), loc}
}

Type {
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" left:Type] -> ({type: "lens", left})
    ["" "=" left:Type] -> ({type: "lens", left, replaceable: false})
    ["" left:Type "/" right:Type] -> ({type: "lens", left, right})
    ["" left:Type "/=" right:Type] -> ({type: "lens", left, right, replaceable: false})
    ["" name:id ["(," ...args:Type]] -> ({type: "constr", name, args, loc: node.loc})
    // Parentheses around one type only group it.
    ["(," ...items:Type] -> items.length === 1 ? items[0] : ({type: "tuple", items} as Type)
    ["{," ...fields:TypeField] -> trecord(fields, node.loc)
    ["{" one:TypeField] -> trecord([one], node.loc)
    ["("] -> ({type: "tuple", items: []})
    // Spaced types lex as one flat list, so each of these takes the rest of it.
    [" " "mut" ...value:*Type] -> mutType(value, node.loc)
    [" " "once" ...value:*Type] -> kinded(value, "once")
    [" " "linear" ...value:*Type] -> kinded(value, "linear")
    [" " ["(," ...args:Type] "=>" ...body:*Type] -> ({type: "fn", args, body})
    [" " ["(," ...args:Type] ["" "=" needs:Needs ">"] ...body:*Type] -> ({type: "fn", args, needs, body})
    [" " one:Type] -> one
}

Term {
    [" " one:Term] -> one
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    ["{" ["" "~" ...lens:*Lens]] -> ({type: "lens", lens})
    linear:Linear -> linear
}

Lens {
    text:re"^[A-Z]" -> ({type: "constructor", name: text.text, args: [], loc: text.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" one:Lens] -> one
    [" " one:Lens] -> one
    ["" fn:re"^[A-Z]" ["(," ...args:Lens]] -> ({type: "constructor", name: fn.text, args, loc: fn.loc})
    ["" fn:Linear ["(," ...args:Term]] -> ({type: "apply", fn, args, loc: node.loc})
    ["" target:Lens ...ops:**LensOp] -> handleLensOps(target, ops, node.loc)
    ["(," ...items:Lens] -> items.length === 1 ? items[0] : ({type: "tuple", items, loc: node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["{" one:Lens] -> one
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Lens] -> ({type: "let", pat, value, body, loc: node.loc})
    ["{\n" [" " "let" "mut" pat:Pat "=" ...value:*Term] ...body:*Lens] -> ({type: "let", pat, value, body, mut: true, loc: node.loc})
    ["{\n" [" " "lens" pat:Pat "<-" ...value:*Linear] ...body:*Linear] -> ({type: "aslens", pat, value, body, loc: node.loc})
    ["{\n" one:Lens] -> one
    ["\n" one:Lens] -> one
    ["{\n" value:Term ...body:*Lens] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body, loc: node.loc})
    [" " "match" value:Term ["{\n" ...cases:LensCase]] -> ({type: "case", value, cases,loc:node.loc})
    [" " "match" value:Term ["{;" ...cases:LensCase]] -> ({type: "case", value, cases,loc:node.loc})
}

// `r.x` lexes flat, as `r`, `.`, `x`, so the dot and the name arrive as separate suffixes.
LensOp {
    ["" ["[" index:Term]] -> ({type: "index", index})
    ["" "."] -> ({type: "dot"})
    ["" name:id] -> ({type: "name", text: name.text})
}

function handleLensOps(target: Lens, ops: LensOp[], loc: number): Lens {
    for (let i = 0; i < ops.length; i++) {
        const op = ops[i]
        if (op.type === "index") target = {type: "index", target, index: op.index, loc}
        else if (op.type === "dot" && ops[i + 1]?.type === "name") {
            target = {type: "field", target, name: (ops[++i] as {text: string}).text, loc}
        } else throw new Error("bad lens suffix " + JSON.stringify(op))
    }
    return target
}

import {partition, ifExpr, infixOf, negate} from "./laminar-helpers.ts"

Linear {
    ["" one:re"^[0-9]+$" "." two:re"^[0-9]+$"] -> ({type: "number", value: +(one.text + '.' + two.text), loc: node.loc})
    re"^[0-9]+$" -> ({type: "number", value: +(node as Id).text, loc: node.loc})
    re"true|false" -> ({type: "bool", value: (node as Id).text === "true", loc: node.loc})
    text:re"^[A-Z]" -> ({type: "constructor", name: text.text, args: [], loc: text.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})

    ["" "!" value:id] -> ({type: "apply", fn: {type: "id", text: "dup", loc: node.loc}, args: [
    {type: "lens", lens: value}
    ], loc: node.loc})
    // `!b[i]` and `!r.x` copy a place, not just a whole binding.
    ["" "!" target:id ...ops:**LensOp] -> ({type: "apply", fn: {type: "id", text: "dup", loc: node.loc}, args: [
    {type: "lens", lens: handleLensOps(target, ops, node.loc)}
    ], loc: node.loc})

    ["\"" text:id] -> ({type: "string", head: text.text, interp: [], loc: node.loc})
    // `#name` reads an entry of what the function needs.
    ["" "#" name:id ...suffixes:**LinearOps] -> handleSuffixes({type: "need", name: name.text, loc: node.loc}, suffixes)
    ["" one:Linear] -> one
    ["" fn:re"^[A-Z]" ["(," ...args:Linear]] -> ({type: "constructor", name: fn.text, args, loc: fn.loc})
    ["" "-" ...arg:*Linear] -> negate(arg, node.loc)
    ["" target:Linear ...suffixes:**LinearOps] -> handleSuffixes(target, suffixes)
    ["{"] -> ({type: "record", fields: [], loc: node.loc})
    ["{," first:SoleRecordItem ...items:RecordItem] -> erecord([first, ...items], node.loc)
    ["{" one:SoleRecordItem] -> erecord([one], node.loc)
    ["(," ...items:Linear] -> ({type: "tuple", items,loc:node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["\"" head:id ...interp:**LinearInterp] -> ({type: "string", head: head.text, interp,loc:node.loc})
    [" " "match" value:Term ["{\n" ...cases:LinearCase]] -> ({type: "case", value, cases,loc:node.loc})
    [" " "match" value:Term ["{;" ...cases:LinearCase]] -> ({type: "case", value, cases,loc:node.loc})

    ["["] -> ({type: "constructor", name: "nil",args:[], loc: node.loc})
    ["[," ...items:Linear] -> econs([...items, ({type: "constructor", name: "nil",args:[], loc: node.loc})], node.loc)
    ["[," ...items:Linear ["" "..." ...tail:*Linear]] -> econs([...items, tail], node.loc)
    ["[:" ["," ...items:Linear]] -> ({type: "vector", items, loc:node.loc})

    /* Would be nice to have an Ann() fn to allow reducing these cases by half */
    [" " "fn" [":" ["" name:id ["(," ...args:FnArg]] ann:Type] body:Term] -> ({type: "fn", name: name.text, args, ann, body,loc:node.loc})
    [" " "fn" ["" name:id ["(," ...args:FnArg]] body:Term] -> ({type: "fn", name: name.text, args, body,loc:node.loc})
    [" " "fn" [":" ["(," ...args:FnArg] ann:Type] body:Term] -> ({type: "fn", args, ann, body,loc:node.loc})
    [" " "fn" ["(," ...args:FnArg] body:Term] -> ({type: "fn", args, body,loc:node.loc})
    [" " lens:Lens ":=" ...value:*Linear] -> ({type: "assign", lens, value,loc:node.loc})
    [" " left:Linear ...right:(op:op right:Linear)] -> partition(left, right)
    // `not` may start an infix expression or follow `&&`/`||`; it negates up to the next of those.
    [" " "not" ...parts:**IfPart] -> infixOf([{kind: "not"}, ...parts], node.loc)
    [" " left:Linear ...parts:**IfPart] -> infixOf([{kind: "value", value: left}, ...parts], node.loc)
    // `if c then a else b` is a match on the Bool; each part may be an infix expression.
    [" " "if" ...parts:**IfPart] -> ifExpr(parts, node.loc)
    [" " one:Linear] -> one
    ["\n" one:Linear] -> one

    ["{\n" [" " "inject" name:id "=" ...value:*Linear] ...body:*Linear] -> ({type: "inject", name: name.text, value, body, loc: node.loc})
    ["\n" [" " "inject" name:id "=" ...value:*Linear] ...body:*Linear] -> ({type: "inject", name: name.text, value, body, loc: node.loc})
    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["{\n" [" " "let" "mut" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body, mut: true, loc:node.loc})
    ["\n" [" " "let" "mut" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body, mut: true, loc:node.loc})
    ["{" one:Linear] -> one
    ["{\n" one:Linear] -> one
    ["{\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body,loc:node.loc})
    ["\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body,loc:node.loc})
}

IfPart {
    ["" "not"] -> ({kind: "not"})
    ["" "if"] -> ({kind: "if"})
    ["" "then"] -> ({kind: "then"})
    ["" "else"] -> ({kind: "else"})
    ["" op:op] -> ({kind: "op", op})
    ["" one:Linear] -> ({kind: "value", value: one})
}

LinearOps {
    // ["" "." attr:id] -> ({type: "attr", attr: attr.text})
    ["" ["[" index:Linear]] -> ({type: "index", index})
    ["" ["(," ...args:Term]] -> ({type: "apply", args})
    ["" ["("]] -> ({type: "apply", args: []})
    ["" "."] -> ({type: "dot"})
    ["" name:id] -> ({type: "name", text: name.text})
}

function handleSuffixes(head: Linear, suffixes: LinearOps[]): Linear {
    for (let i = 0; i < suffixes.length; i++) {
        const suffix = suffixes[i]
        switch (suffix.type) {
            case "index": head = {type: "index", index: suffix.index, target: head,loc:head.loc}; continue
            case "apply": head = {type: "apply", fn: head, args: suffix.args,loc:head.loc}; continue
            case "dot": {
                const name = suffixes[i + 1]
                if (name?.type !== "name") break
                head = {type: "field", target: head, name: name.text, loc:head.loc}
                i++
                continue
            }
        }
        throw new Error("bad suffix" + JSON.stringify(suffix))
    }
    return head
}

FnArg {
    pat:Pat -> ({pat})
    [":" pat:Pat typ:Type] -> ({pat, typ})
    [" " "mut" pat:Pat] -> ({pat, mut: true})
    [":" [" " "mut" pat:Pat] typ:Type] -> ({pat, typ, mut: true})
    // A kind lexes next to the parameter's name, and implies `mut`.
    [" " [":" pat:Pat "once"] ...value:*Type] -> ({pat, typ: kinded(value, "once"), mut: true})
    [" " [":" pat:Pat "linear"] ...value:*Type] -> ({pat, typ: kinded(value, "linear"), mut: true})
    [" " "mut" [":" pat:Pat "once"] ...value:*Type] -> ({pat, typ: kinded(value, "once"), mut: true})
    [" " "mut" [":" pat:Pat "linear"] ...value:*Type] -> ({pat, typ: kinded(value, "linear"), mut: true})
    // A function type holds the parameter it annotates, as in a record field.
    [" " [":" pat:Pat ["(," ...args:Type]] "=>" ...body:*Type] -> ({pat, typ: {type: "fn", args, body} as Type})
    [" " [":" pat:Pat ["(," ...args:Type]] ["" "=" needs:Needs ">"] ...body:*Type] -> ({pat, typ: {type: "fn", args, needs, body} as Type})
    [" " "mut" [":" pat:Pat ["(," ...args:Type]] "=>" ...body:*Type] -> ({pat, typ: {type: "fn", args, body} as Type, mut: true})
    [" " "mut" [":" pat:Pat ["(," ...args:Type]] ["" "=" needs:Needs ">"] ...body:*Type] -> ({pat, typ: {type: "fn", args, needs, body} as Type, mut: true})
}

LinearCase {
    [" " pat:Pat "->" ...body:*Linear] -> ({pat, body})
    [" " "mut" pat:Pat "->" ...body:*Linear] -> ({pat, body, mut: true})
}

LensCase {
    [" " pat:Pat "->" ...body:*Lens] -> ({pat, body})
    [" " "mut" pat:Pat "->" ...body:*Lens] -> ({pat, body, mut: true})
}

LinearInterp {
    ["\"" value:Linear tail:id] -> ({value, tail: tail.text})
}
