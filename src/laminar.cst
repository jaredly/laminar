@config {
    reserved: [let lens ~ <- = := case :: => _]
}

File {
    ["\n" ...items:FileItem] -> items
    item:FileItem -> [item]
}

FileItem {
    [" " name:id "::" ...ann:*Type] -> ({type: "decl", name, ann, loc: node.loc})
    linear:Linear -> linear
}

function pcons(items:Pat[], loc:number) {
    let last = items[items.length - 1]
    for (let i=items.length-2;i>=0;i--) {
        last = {type:"constructor",name:"cons",args:[items[i], last],loc}
    }
    return last
}

function econs(items:Linear[], loc:number) {
    let last = items[items.length - 1]
    for (let i=items.length-2;i>=0;i--) {
        last = {type:"constructor",name:"cons",args:[items[i], last],loc}
    }
    return last
}

Pat {
    "_" -> ({type: "drop", loc: node.loc})
    name:re"^[A-Z]" -> ({type: "constructor", name: name.text, args: [], loc: node.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" inner:Pat] -> ({type: "lens", inner, loc: node.loc})
    ["" name:id ["(," ...args:Pat]] -> ({type: "constructor", name: name.text, args, loc: node.loc})
    ["(," ...items:Pat] -> items.length === 1 ? items[0] : ({type: "tuple", items, loc: node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["["] -> ({type: "constructor", name: "nil",args:[], loc: node.loc})
    ["[," ...items:Pat] -> pcons([...items, ({type: "constructor", name: "nil",args:[], loc: node.loc})], node.loc)
    ["[," ...items:Pat ["" "..." tail:Pat]] -> pcons([...items, tail], node.loc)
    // [":" head:id tail:id] -> ({type: "pcons", head, tail, loc: node.loc})
    // ["[," ...items:Pat] -> ({type: "list", items, tail: null, loc: node.loc})
    // ["[," ...items:Pat ["" "..." tail:Pat]] -> ({type: "list", items, tail, loc: node.loc})
}

Type {
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" "~" left:Type] -> ({type: "lens", left})
    ["" left:Type "/" right:Type] -> ({type: "lens", left, right})
    ["(," ...items:Type] -> ({type: "tuple", items})
    ["("] -> ({type: "tuple", items: []})
    [" " ["(," ...args:Type] "=>" body:Type] -> ({type: "fn", args, body})
}

Term {
    [" " one:Term] -> one
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    ["{" ["" "~" ...lens:*Lens]] -> ({type: "lens", lens})
    linear:Linear -> linear
}

Lens {
    text:id -> ({type: "id", text: text.text, loc: node.loc})
    ["" one:Lens] -> one
    [" " one:Lens] -> one
    ["" "@" ["(," frontend:Linear backend:Linear]] -> ({type: "manual", frontend, backend, loc: node.loc})
    ["" fn:Linear ["(," ...args:Term]] -> ({type: "apply", fn, args, loc: node.loc})
    ["(," ...items:Lens] -> items.length === 1 ? items[0] : ({type: "tuple", items, loc: node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["{" one:Lens] -> one
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Lens] -> ({type: "let", pat, value, body, loc: node.loc})
    ["{\n" [" " "lens" pat:Pat "<-" ...value:*Linear] ...body:*Linear] -> ({type: "aslens", pat, value, body, loc: node.loc})
    ["{\n" one:Lens] -> one
    ["{\n" value:Term ...body:*Lens] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body, loc: node.loc})
    [" " "match" value:Term ["{\n" ...cases:LensCase]] -> ({type: "case", value, cases,loc:node.loc})
    [" " "match" value:Term ["{;" ...cases:LensCase]] -> ({type: "case", value, cases,loc:node.loc})
}

import {partition} from "./laminar-helpers.ts"

Linear {
    re"^[0-9]+$" -> ({type: "const", value: +(node as Id).text, loc: node.loc})
    re"true|false" -> ({type: "const", value: (node as Id).text === "true", loc: node.loc})
    text:re"^[A-Z]" -> ({type: "constructor", name: text.text, args: [], loc: text.loc})
    text:id -> ({type: "id", text: text.text, loc: node.loc})

    ["\"" text:id] -> ({type: "string", head: text.text, interp: [], loc: node.loc})
    ["" one:Linear] -> one
    ["" fn:re"^[A-Z]" ["(," ...args:Linear]] -> ({type: "constructor", name: fn.text, args, loc: fn.loc})
    ["" fn:re"^[+-]$" ...arg:*Linear] -> ({type: "apply", fn, args: [arg],loc:node.loc})
    ["" target:Linear ...suffixes:**LinearOps] -> handleSuffixes(target, suffixes)
    ["(," ...items:Linear] -> ({type: "tuple", items,loc:node.loc})
    ["("] -> ({type: "tuple", items: [], loc: node.loc})
    ["\"" head:id ...interp:**LinearInterp] -> ({type: "string", head: head.text, interp,loc:node.loc})
    [" " "match" value:Term ["{\n" ...cases:LinearCase]] -> ({type: "case", value, cases,loc:node.loc})
    [" " "match" value:Term ["{;" ...cases:LinearCase]] -> ({type: "case", value, cases,loc:node.loc})

    ["["] -> ({type: "constructor", name: "nil",args:[], loc: node.loc})
    ["[," ...items:Linear] -> econs([...items, ({type: "constructor", name: "nil",args:[], loc: node.loc})], node.loc)
    ["[," ...items:Linear ["" "..." tail:Linear]] -> econs([...items, tail], node.loc)

    /* Would be nice to have an Ann() fn to allow reducing these cases by half */
    [" " "fn" [":" ["" name:id ["(," ...args:FnArg]] ann:Type] body:Term] -> ({type: "fn", name: name.text, args, ann, body,loc:node.loc})
    [" " "fn" ["" name:id ["(," ...args:FnArg]] body:Term] -> ({type: "fn", name: name.text, args, body,loc:node.loc})
    [" " "fn" [":" ["(," ...args:FnArg] ann:Type] body:Term] -> ({type: "fn", args, ann, body,loc:node.loc})
    [" " "fn" ["(," ...args:FnArg] body:Term] -> ({type: "fn", args, body,loc:node.loc})
    [" " lens:Lens ":=" ...value:*Linear] -> ({type: "assign", lens, value,loc:node.loc})
    [" " left:Linear ...right:(op:op right:Linear)] -> partition(left, right)
    [" " one:Linear] -> one
    ["\n" one:Linear] -> one

    ["{\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["\n" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Linear] -> ({type: "let", pat, value, body,loc:node.loc})
    ["{" one:Linear] -> one
    ["{\n" one:Linear] -> one
    ["{\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body,loc:node.loc})
    ["\n" value:Linear ...body:*Linear] -> ({type: "let", pat: {type: "drop", loc:node.loc}, value, body,loc:node.loc})
}

LinearOps {
    // ["" "." attr:id] -> ({type: "attr", attr: attr.text})
    // ["" ["[" index:Linear]] -> ({type: "index", index})
    ["" ["(," ...args:Term]] -> ({type: "apply", args})
    ["" ["("]] -> ({type: "apply", args: []})
}

function handleSuffixes(head: Linear, suffixes: LinearOps[]): Linear {
    return suffixes.reduce((head, suffix): Linear => {
        switch (suffix.type) {
            // case "attr": return {type: "attr", target: head, attr: suffix.attr,loc:head.loc}
            // case "index": return {type: "index", index: suffix.index, target: head,loc:head.loc}
            case "apply": return {type: "apply", fn: head, args: suffix.args,loc:head.loc}
        }
        throw new Error("bad suffix" + JSON.stringify(suffix))
    }, head)
}

FnArg {
    pat:Pat -> ({pat})
    [":" pat:Pat typ:Type] -> ({pat, typ})
}

LinearCase {
    [" " pat:Pat "->" ...body:*Linear] -> ({pat, body})
}

LensCase {
    [" " pat:Pat "->" ...body:*Lens] -> ({pat, body})
}

LinearInterp {
    ["\"" value:Linear tail:id] -> ({value, tail: tail.text})
}


/*
Linear {
    ["" ...children:*] -> parseOp(children)
    ["\"" head:id ...interp:(value:Linear tail:id)] -> {head: head.text, interp}
    ["{" child:Linear] -> child
    ["{" ...block:*Block] -> block
    ["("] -> ({type: 'const', value: null})
    ["(" one:Linear] -> one
    ["(" ...items:Linear] -> ({type: "tuple", items})
    [" " one:Linear] -> one
    [" " "match" value:Linear ["{\n" ...cases:LinearCase]] -> ({type: "case", value, cases})
    // if the fncall has a no binding, then the bindings are splatted in.
    [" " "fn" Ann(["(" ...args:FnArg]) body:FnBody] -> ({type: "fn", args, ann, body})
    [" " lens:Lens "<-" ...value:*Linear] -> ({type: "assign", lens, value})
    [" " left:Linear ...right:(op:op right:Linear)] -> partition(left, right)
}

FnBody {
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    ["{" one:Term] -> one
    ["{" ...block:*Block] -> block
    one:Linear -> Linear
}

// A fn allows optional bindings
Ann(inner) {
    [": " inner ann:Type]
    inner
}

LinearCase {
    [" " pat:Pat "=>" ...body:*Linear] -> ({pat, body})
}

Block {
    ["{" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Block] -> ({type: "let", pat, value, body})
    ["{" value:Term ...body:*Block] => ({type: "let", pat: {type: "tuple", items: []}, value, body})
}
*/
