Pat {
    "_" -> ({type: "drop"})
    text:id -> ({type: "id", text: text.text})
    ["" "~" inner:Pat] -> ({type: "lens", inner})
    ["" name:id ["(" ...args:Pat]] -> ({type: "constructor", name: name.text, args})
    ["(" ...items:Pat] -> ({type: "tuple", items})
}

Type {
    text:id -> ({type: "id", text: text.text})
    ["" "~" left:Type] -> ({type: "lens", left})
    ["" left:Type "/" right:Type] -> ({type: "lens", left, right})
    ["(" ...items:Type] -> ({type: "tuple", items})
    [" " ["(" ...args:Type] "=>" body:Type] -> ({type: "fn", args, body})
}

Term {
    ["" "~" ...lens:*Lens] -> ({type: "lens", lens})
    linear:Linear -> linear
}

Lens {
    text:id -> ({type: "id", text: text.text})
    ["" one:Lens] -> one
    ["" fn:Linear ["(" ...args:Term]] -> ({type: "apply", fn, args})
    ["(" ...items:Lens] -> ({type: "tuple", items})
    ["{" one:Lens] -> one
    ["{" [" " "let" pat:Pat "=" ...value:*Term] ...body:*Lens] -> ({type: "let", pat, value, body})
    ["{" [" " "lens" pat:Pat "<-" ...value:*Linear] ...body:*Linear] -> ({type: "aslens", pat, value, body})
}

Linear {
    // TODO: add regex support
    // node:re"^[0-9]+$" -> ({type: "const", value: +node.text})
    "true" -> ({type: "const", value: true})
    "false" -> ({type: "const", value: false})
    text:id -> ({type: "id", text: text.text})
    ["" one:Linear] -> one
    ["" fn:op ...arg:*Linear] -> ({type: "apply", fn, args: [arg]})
    ["" fn:Linear ...suffixes:**LinearOps] -> ({type: "apply", fn, suffixes})
    ["(" ...items:Linear] -> ({type: "tuple", items})
    ["\"" head:id ...interp:LinearInterp] -> ({type: "string", head: head.text, interp})
    [" " "match" value:Linear ["{" ...cases:LinearCase]] -> ({type: "case", value, cases})

    // Would be nice to have an Ann() fn to allow reducing these cases by half
    [" " "fn" [": " ["" name:id ["(" ...args:FnArg]] ann:Type] body:Linear] -> ({type: "fn", name: name.text, args, ann, body})
    [" " "fn" ["" name:id ["(" ...args:FnArg]] body:Linear] -> ({type: "fn", name: name.text, args, body})
    [" " "fn" [": " ["(" ...args:FnArg] ann:Type] body:Linear] -> ({type: "fn", args, ann, body})
    [" " "fn" ["(" ...args:FnArg] body:Linear] -> ({type: "fn", args, body})
    [" " lens:Lens ":=" ...value:*Linear] -> ({type: "assign", lens, value})
    // Hmm what's the best way for this
    // [" " left:Linear ...ops:(op:op right:Linear)] -> ({left, ops})
    [" " one:Linear] -> one
}

LinearOps {
    ["" "." attr:id] -> ({type: "attr", attr: attr.text})
    ["" ["[" index:Linear]] -> ({type: "index", index})
    ["" ["(" ...args:Linear]] -> ({type: "apply", args})
}

