// laminar: dual
// how to guess my number
type direction {
    Higher
    Lower
}

fn nextGuess(direction, ~(min, max, lastGuess)) {
    round(
        match direction {
            Higher -> {(!max + !lastGuess) / 2}
            Lower -> {(!lastGuess + !min) / 2}
        }
    )
}

fn handleResponse(response, ~state) {
    match response {
        "higher" -> {
            let mut next = nextGuess(Higher, ~state)
            let (min, _, last) = ~state
            min := last
            last := next
            false
        }
        "lower" -> {
            let mut next = nextGuess(Lower, ~state)
            let (_, max, last) = ~state
            max := last
            last := next
            false
        }
        "match" -> true
        _ -> {
            print("I'm sorry, I didn't understand that. Please say 'higher', 'lower', or 'match'")
            false
        }
    }
}

fn step(steps, ~(min, max, lastGuess)) {
    let input = getInput("My guess is ${!lastGuess} (higher/lower/match): ")
    let next = handleResponse(input, ~(min, max, lastGuess))
    match (next) {
        true -> steps
        false -> step(steps + 1, ~(min, max, lastGuess))
    }
}

fn game() {
    let mut state = (0, 100, 50)
    let steps = step(0, ~state)
    (state, steps)
}

{
    game()
}

