// laminar: dual
// a small concurrent web server: every connection is served by its own task, and at most
// eight are open at once.
// run it with `bun cli/laminar.ts run examples/server-bounded.lm --target go`, then try
//   curl localhost:8080/            curl localhost:8080/count
//   curl localhost:8080/mandelbrot  curl localhost:8080/slow   (run more than eight at once)
//
// This is server.lm with a limit. The accept loop takes a free slot from a channel before it
// accepts, and a task puts its slot back once its connection is closed. Compare
// server-pool.lm, which limits connections with eight workers that each accept their own.
// server-workers.lm has long-running workers instead, which one loop sends connections to.
//
// What the language guarantees here, with no locks:
// - `spawn(task)` runs a closure on its own task. A closure moves or shares what it
//   captures and can never borrow, so a task cannot reach another task's mutable data.
// - A connection is a lens that `connection` produces, and `connection` owns its cleanup.
//   It moves into the task that serves it, and `handle` takes it from there, so it is
//   closed by the time `handle` returns. The accept loop cannot use it again.
// - The connection is a `linear` type, so `dup(~conn)` is a type error. Over a plain number
//   a copy of the handle could be sent elsewhere and used after the connection closed.
// - Plain values are immutable, so any number of tasks can read them. The only state that
//   changes is the request count, and one task owns it: others ask it over a channel.
//
// The slots are a convention, not something the language checks: a task that did not send
// its slot back would leave the server with one fewer.

// ---- reading the request ----

// the text after the first space of "GET /path HTTP/1.1"
fn afterMethod(chars) {
    match chars {
        [] -> []
        [" ", ...rest] -> rest
        [_, ...rest] -> afterMethod(rest)
    }
}

fn untilSpace(chars) {
    match chars {
        [] -> ""
        [" ", ..._] -> ""
        ["\r", ..._] -> ""
        ["\n", ..._] -> ""
        [c, ...rest] -> "${c}${untilSpace(rest)}"
    }
}

fn pathOf(request) { untilSpace(afterMethod(charList(request))) }

// ---- the pages ----

fn glyph(steps) {
    if steps >= 30 then "#" else if steps >= 12 then "+" else if steps >= 5 then "." else " "
}

// how many steps z -> z*z + c takes to leave the circle of radius 2
fn escape(cr, ci, zr, zi, n) {
    if n >= 40 || zr * zr + zi * zi > 4 then n else {
        escape(cr, ci, zr * zr - zi * zi + cr, 2 * zr * zi + ci, n + 1)
    }
}

fn artRow(x, y) {
    if x >= 64 then "" else {
        let steps = escape(x * 0.046875 - 2.2, 1.2 - y * 0.1, 0, 0, 0)
        "${glyph(steps)}${artRow(x + 1, y)}"
    }
}

fn art(y) {
    if y >= 24 then "" else "${artRow(0, y)}\n${art(y + 1)}"
}

// the request counter lives in one task: it is a parameter, so nothing else can touch it
fn counter(requests, count) {
    let reply = chanRecv(requests)
    chanSend(reply, count + 1)
    counter(requests, count + 1)
}

fn nextRequest(requests) {
    let reply = chanNew()
    chanSend(requests, reply)
    chanRecv(reply)
}

fn page(path, requests) {
    match path {
        "/" -> ("200 OK", "hello from laminar\n")
        "/count" -> ("200 OK", "request number ${nextRequest(requests)}\n")
        "/mandelbrot" -> ("200 OK", art(0))
        "/slow" -> {
            sleep(1000)
            ("200 OK", "that took a second, and nobody waited for it\n")
        }
        _ -> ("404 Not Found", "no page at ${path}\n")
    }
}

// ---- serving ----

// a connection cannot be copied: dup(~conn) is a type error
type linear Conn {
    Conn(Number)
}

// these borrow the connection. A lens argument comes last.
fn recvFrom(~conn) {
    match ~conn {
        Conn(fd) -> recv(dup(~fd))
    }
}

fn sendTo(text, ~conn) {
    match ~conn {
        Conn(fd) -> send(dup(~fd), text)
    }
}

// the producer owns the cleanup. It borrows no lens, so the lens it returns is owned
fn connection(listener) ~{
    lens conn <- Conn(accept(listener))
    match conn {
        Conn(fd) -> closeHandle(fd)
    }
}

// `mut ~` takes the lens: this function reads, answers, and the connection closes with it
fn handle(requests, mut ~conn) {
    let (status, body) = page(pathOf(recvFrom(~conn)), requests)
    sendTo("HTTP/1.1 ${status}\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n${body}", ~conn)
}

// at most `limit` connections are open because the loop takes a slot before it accepts
fn serve(listener, requests, slots) {
    let slot = chanRecv(slots)
    let conn = ~connection(listener)
    spawn(fn () {
        // `handle` takes the connection and closes it, so the slot is free only after that
        handle(requests, ~conn)
        chanSend(slots, slot)
    })
    serve(listener, requests, slots)
}

// channels hold nothing, so each free slot is a small task waiting to hand itself over
fn openSlots(limit, slots) {
    if limit == 0 then () else {
        spawn(fn () { chanSend(slots, dup(limit)) })
        openSlots(limit - 1, slots)
    }
}

{
    let listener = listen(8080)
    let requests = chanNew()
    let slots = chanNew()
    print("listening on http://localhost:8080, with at most 8 connections open")
    spawn(fn () { counter(requests, 0) })
    openSlots(8, slots)
    serve(listener, requests, slots)
}
