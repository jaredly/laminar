
// type Option(a) {
//     Some(a)
//     None
// }

fn replace(needle, repl, ~lst) {
    match ~lst {
        [one, ...rest] -> {
            match (dup(~one) == dup(~needle)) {
                true -> {
                    one := repl
                    ()
                }
                false -> {
                    replace(needle, repl, ~rest)
                }
            }
        }
        [] -> ()
    }
}

fn find(needle, ~lst) ~{
    match ~lst {
        [one, ...rest] -> {
            match (dup(~one) == dup(~needle)) {
                true -> Some(one)
                false -> {
                    find(needle, ~rest)
                }
            }
        }
        [] -> None
    }
}

{
    let x = [1,2,3,4]
    replace(2, 5, ~x)
    match ~find(3, ~x) {
        Some(one) -> {
            one := 3
            ()
        }
        None -> ()
    }
    x
}
