// laminar: dual
// two players take turns at the keyboard. cells hold "." (empty), "X" or "O".
fn at(i, ~board) {
    dup(~board[i])
}

fn row(a, ~board) {
    "${at(a, ~board)} ${at(a + 1, ~board)} ${at(a + 2, ~board)}"
}

fn render(~board) {
    print(row(0, ~board))
    print(row(3, ~board))
    print(row(6, ~board))
}

// who owns the line, or "." if nobody does
fn lineOwner(a, b, c, ~board) {
    let first = at(a, ~board)
    if first != "." && first == at(b, ~board) && first == at(c, ~board) then first else "."
}

fn winnerIn(lines, ~board) {
    match lines {
        [] -> "."
        [(a, b, c), ...rest] -> {
            match lineOwner(a, b, c, ~board) {
                "." -> winnerIn(rest, ~board)
                owner -> owner
            }
        }
    }
}

fn winner(~board) {
    winnerIn([(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6), (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)], ~board)
}

// the square a player typed, or 9 for something that isn't one
fn parseSquare(input) {
    match input {
        "1" -> 0
        "2" -> 1
        "3" -> 2
        "4" -> 3
        "5" -> 4
        "6" -> 5
        "7" -> 6
        "8" -> 7
        "9" -> 8
        _ -> 9
    }
}

fn other(player) {
    if player == "X" then "O" else "X"
}

// asks until the player names an empty square, then claims it
fn takeTurn(player, ~board) {
    let input = getInput("${player}, pick a square (1-9): ")
    let square = parseSquare(input)
    if square == 9 then {
        print("Please pick a number from 1 to 9.")
        takeTurn(player, ~board)
    } else if at(square, ~board) != "." then {
        print("That square is taken.")
        takeTurn(player, ~board)
    } else {
        board[square] := dup(player)
        ()
    }
}

// plays until someone wins (their symbol) or the board fills up ("draw")
fn play(player, turns, ~board) {
    render(~board)
    match winner(~board) {
        "." -> {
            if turns == 9 then "draw" else {
                takeTurn(player, ~board)
                play(other(player), turns + 1, ~board)
            }
        }
        owner -> owner
    }
}

fn game() {
    let mut board = array(9, ".")
    play("X", 0, ~board)
}

{
    game()
}

