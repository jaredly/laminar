// laminar: dual
// two players take turns at the keyboard.
type cell {
    Empty
    X
    O
}

// the nine places on the board, left to right and top to bottom
type square {
    C0
    C1
    C2
    C3
    C4
    C5
    C6
    C7
    C8
}

type outcome {
    Won(cell)
    Draw
}

fn symbol(c) {
    match c {
        Empty -> "."
        X -> "X"
        O -> "O"
    }
}

// where a square lives in the board vector
fn slot(sq) {
    match sq {
        C0 -> 0
        C1 -> 1
        C2 -> 2
        C3 -> 3
        C4 -> 4
        C5 -> 5
        C6 -> 6
        C7 -> 7
        C8 -> 8
    }
}

fn cellAt(sq, ~board) {
    !board[slot(sq)]
}

fn row(a, b, c, ~board) {
    "${symbol(cellAt(a, ~board))} ${symbol(cellAt(b, ~board))} ${symbol(cellAt(c, ~board))}"
}

fn render(~board) {
    print(row(C0, C1, C2, ~board))
    print(row(C3, C4, C5, ~board))
    print(row(C6, C7, C8, ~board))
}

// who owns the line, or Empty if nobody does
fn lineOwner(a, b, c, ~board) {
    let first = cellAt(a, ~board)
    if first != Empty && first == cellAt(b, ~board) && first == cellAt(c, ~board) then first else Empty
}

fn winnerIn(lines, ~board) {
    match lines {
        [] -> Empty
        [(a, b, c), ...rest] -> {
            match lineOwner(a, b, c, ~board) {
                Empty -> winnerIn(rest, ~board)
                owner -> owner
            }
        }
    }
}

fn winner(~board) {
    winnerIn([
            (C0, C1, C2), (C3, C4, C5), (C6, C7, C8),
            (C0, C3, C6), (C1, C4, C7), (C2, C5, C8),
            (C0, C4, C8), (C2, C4, C6),
        ], ~board)
}

// the square a player typed, if it is one
fn parseSquare(input) {
    match input {
        "1" -> Some(C0)
        "2" -> Some(C1)
        "3" -> Some(C2)
        "4" -> Some(C3)
        "5" -> Some(C4)
        "6" -> Some(C5)
        "7" -> Some(C6)
        "8" -> Some(C7)
        "9" -> Some(C8)
        _ -> None
    }
}

fn other(player) {
    match player {
        X -> O
        _ -> X
    }
}

// asks until the player names an empty square, then claims it
fn takeTurn(player, ~board) {
    let input = getInput("${symbol(player)}, pick a square (1-9): ")
    match parseSquare(input) {
        None -> {
            print("Please pick a number from 1 to 9.")
            takeTurn(player, ~board)
        }
        Some(square) -> {
            if cellAt(square, ~board) != Empty then {
                print("That square is taken.")
                takeTurn(player, ~board)
            } else {
                board[slot(square)] := dup(player)
                ()
            }
        }
    }
}

// plays until someone wins or the board fills up
fn play(player, turns, ~board) {
    render(~board)
    match winner(~board) {
        Empty -> {
            if turns == 9 then Draw else {
                takeTurn(player, ~board)
                play(other(player), turns + 1, ~board)
            }
        }
        owner -> Won(owner)
    }
}

fn game() {
    let mut board = array(9, Empty)
    let result = play(X, 0, ~board)
    match result {
        Won(who) -> print("${symbol(who)} wins!")
        Draw -> print("It's a draw.")
    }
    result
}

{
    game()
}

