/*
// --------------------
// Prelude
// --------------------
// The functions in this section are defined without function bodies.
// They are implemented in Linear Haskell in `linear-base` or the prelude `FlowPrelude.hs`.
// --------------------

// In Linear Haskell, these actually have typeclass constraints on `a`.
putStrLn :: String -> ~World -> ()
print :: a -> ~World -> ()
dup :: ~a -> a
consume :: a -> ()

// These file-management functions use built-in types for the real-world and file handles.
openFile :: String -> ~World -> Handle
truncateFile :: String -> ~World -> Handle
readFile :: ~(World, Handle) -> String
writeFile :: String -> ~(World, Handle) -> ()
closeFile :: Handle -> ~World -> ()
*/
// --------------------
// Stack-based evaluator
// --------------------
// In this section, we use flow typing to implement a stack-based evaluator.
// We use flow parameters to model the state of the stack.
// Instructions are integers (push the number to the stack)
// or characters that have an effect on the stack, such as adding the top two numbers
// or printing the topmost number.
// --------------------
// Pop an element from a list in-place.
// pop :: ~(List Int) -> Int
fn pop(~xs) (
    match xs {
        [y, ...ys] -> {
            xs := ys
            y
        }
    }
)

ir-> (xs0)=>((match xs0 {[y1, ...ys2] -> block{let _ = swap(xs0, ys2)}{y1}{}}), xs0)

{
    let x = [1, 2, 3]
    pop(~x)
    x
}

[2, 3]

ir-> block{
    let x0 = [1, 2, 3];
    let _ = block{let (r1, l2) = pop(x0)}{r1}{swap(x0, l2)}
}{x0}{}

// Push an element onto a list in-place.
// push :: Int -> ~(List Int) -> ()
fn push(x, ~xs) {xs := [x, ...xs]}

ir-> (x0, xs1)=>(swap(xs1, [x0, ...xs1]), xs1)

{
    let x = [1, 2]
    push(5, ~x)
    x
}

[5, 1, 2]

ir-> block{
    let x0 = [1, 2];
    let _ = block{let (r1, l2) = push(5, x0)}{r1}{swap(x0, l2)}
}{x0}{}

