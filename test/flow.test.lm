}{}

// exec :: List (Either Int Char) -> ~(List Int, World) -> ()
fn exec(is, ~(stk, w)) (
    match is {
        [] -> ()
        [Left(n), ...is] -> {
            push(n, ~stk)
            exec(is, ~(stk, w))
        }
        [Right("+"), ...is] -> {
            push(pop(~stk) + pop(~stk), ~stk)
            exec(is, ~(stk, w))
        }
        [Right("-"), ...is] -> {
            push(pop(~stk) - pop(~stk), ~stk)
            exec(is, ~(stk, w))
        }
        [Right("*"), ...is] -> {
            push(pop(~stk) * pop(~stk), ~stk)
            exec(is, ~(stk, w))
        }
        [Right("/"), ...is] -> {
            push(pop(~stk) / pop(~stk), ~stk)
            exec(is, ~(stk, w))
        }
        [Right("p"), ...is] -> {
            print(pop(~stk), ~w)
            exec(is, ~(stk, w))
        }
        [Right("d"), ...is] -> {
            let x = pop(~stk)
            push(dup(~x), ~stk)
            push(x, ~stk)
            exec(is, ~(stk, w))
        }
        [Right(x), ...is] -> {
            putStrLn("Unrecognised operation:", ~w)
            print(x, ~w)
            exec(is, ~(stk, w))
        }
    }
)

ir-> (*is0, &(stk1, w2))=>(
    match *is0 {
        *[] -> ()
        *[Left(n3), ...is4] -> block{let *_5 = push(*n3, &stk1)}{exec(*is4, &(stk1, w2))}{}
        *[Right("+"), ...is6] -> block{let *_7 = push(+(pop(&stk1), pop(&stk1)), &stk1)}{exec(*is6, &(stk1, w2))}{}
        *[Right("-"), ...is8] -> block{let *_9 = push(-(pop(&stk1), pop(&stk1)), &stk1)}{exec(*is8, &(stk1, w2))}{}
        *[Right("*"), ...is10] -> block{
            let *_11 = push((*(pop(&stk1), pop(&stk1))), &stk1)
        }{exec(*is10, &(stk1, w2))}{}
        *[Right("/"), ...is12] -> block{let *_13 = push(/(pop(&stk1), pop(&stk1)), &stk1)}{exec(*is12, &(stk1, w2))}{}
        *[Right("p"), ...is14] -> block{let *_15 = print(pop(&stk1), &w2)}{exec(*is14, &(stk1, w2))}{}
        *[Right("d"), ...is16] -> block{
            let *x17 = pop(&stk1);
            let *_18 = push(dup(&x17), &stk1);
            let *_19 = push(*x17, &stk1)
        }{exec(*is16, &(stk1, w2))}{}
        *[Right(x20), ...is21] -> block{
            let *_22 = putStrLn("Unrecognised operation:", &w2);
            let *_23 = print(*x20, &w2)
        }{exec(*is21, &(stk1, w2))}{}
    }
)

fn run(is) {
    let stk = []
    let w = 0
    exec(is, ~(stk, w))
    stk
}

ir-> (*is0)=>block{
    let *stk1 = [];
    let *w2 = 0;
    let *_3 = exec(*is0, &(stk1, w2))
}{*stk1}{}

{run([Left(5), Left(3), Right("+")])}

[8]

ir-> run([Left(5), Left(3), Right("+")])

run(
    [
        Left(5), Left(10), Right("*"), Left(52), Right("-")
    ]
)

[2]

ir-> run(
    [
        Left(5), Left(10), Right("*"), Left(52), Right("-")
    ]
)

// --------------------
// Examples from "From Linearity to Borrowing", Wagner et al.
// (https://dl.acm.org/doi/10.1145/3764117)
// --------------------
//
// First we need to establish some basic functions on lists.
// negate :: Bool -> Bool
fn negate(b) (
    match b {
        true -> false
        false -> true
    }
)

ir-> (*b0)=>(
    match *b0 {
        *true -> false
        *false -> true
    }
)

{negate(true)}

false

ir-> negate(true)

// Consumes the input.
// length' :: List String -> Int
fn length'(xs) (
    match xs {
        [] -> 0
        [y, ...ys] -> {
            drop(y)
            1 + length'(ys)
        }
    }
)

ir-> (*xs0)=>(
    match *xs0 {
        *[] -> 0
        *[y1, ...ys2] -> block{let *_3 = drop(*y1)}{+(1, length'(*ys2))}{}
    }
)

{length'([1, 2, 3])}

3

ir-> length'([1, 2, 3])

// length :: ~List a -> Int
fn length(~xs) (
    match ~xs {
        [] -> 0
        [y, ...ys] -> 1 + length(~ys)
    }
)

ir-> (&xs0)=>(
    match &xs0 {
        &[] -> 0
        &[y1, ...ys2] -> +(1, length(&ys2))
    }
)

{
    let x = [1, 2, 3]
    (length(~x), x)
}

(3, [1, 2, 3])

ir-> block{let *x0 = [1, 2, 3]}{(length(&x0), *x0)}{}

// split :: Char -> String -> (String, String)
fn split(c, xs) (
    match xs {
        [] -> {
            consume(c)
            ([], [])
        }
        [x, ...xs] -> (
            match (dup(~x) == dup(~c)) {
                true -> {
                    consume(x)
                    consume(c)
                    ([], xs)
                }
                false -> {
                    let (y, z) = split(c, xs)
                    ([x, ...y], z)
                }
            }
        )
    }
)

ir-> (*c0, *xs1)=>(
    match *xs1 {
        *[] -> block{let *_2 = consume(*c0)}{([], [])}{}
        *[x3, ...xs4] -> (
            match ==(dup(&x3), dup(&c0)) {
                *true -> block{
                    let *_5 = consume(*x3);
                    let *_6 = consume(*c0)
                }{([], *xs4)}{}
                *false -> block{let *(y7, z8) = split(*c0, *xs4)}{([*x3, ...*y7], *z8)}{}
            }
        )
    }
)

split(" ", charList("One two"))

(charList("One"), charList("two"))

ir-> split(" ", charList("One two"))

split(" ", charList("nope"))

(charList("nope"), [])

ir-> split(" ", charList("nope"))

// splitMany :: Char -> String -> List String
fn splitMany(c, xs) (
    match split(dup(~c), xs) {
        (word, []) -> {
            consume(c)
            [word]
        }
        (word, tail) -> [word, ...splitMany(c, tail)]
    }
)

ir-> (*c0, *xs1)=>(
    match split(dup(&c0), *xs1) {
        *(word2, []) -> block{let *_3 = consume(*c0)}{[*word2]}{}
        *(word4, tail5) -> [*word4, ...splitMany(*c0, *tail5)]
    }
)

{splitMany(" ", charList("A B C"))}

(["A"], ["B"], ["C"])

ir-> splitMany(" ", charList("A B C"))

// words :: String -> List String
fn words(text) splitMany(" ", text)

ir-> (*text0)=>splitMany(" ", *text0)

// lines :: String -> List String
fn lines(text) splitMany("\n", text)

ir-> (*text0)=>splitMany("\n", *text0)

// fileWords :: ~(World, Handle) -> Int
fn fileWords(~(w, f)) length'(words(charList(readFile(~(w, f)))))

ir-> (&(w0, f1))=>length'(words(charList(readFile(&(w0, f1)))))

// fileLines :: ~(World, Handle) -> Int
fn fileLines(~(w, f)) length'(lines(charList(readFile(~(w, f)))))

ir-> (&(w0, f1))=>length'(lines(charList(readFile(&(w0, f1)))))

// avg :: ~World -> ()
fn avg(fileName, ~w) {
    let f = openFile(fileName, ~w)
    putStrLn(
        "This source file has the following average number of words per line:", ~w
    )
    print(fileWords(~(w, f)) / fileLines(~(w, f)), ~w)
    closeFile(f, ~w)
}

ir-> (*fileName0, &w1)=>block{
    let *f2 = openFile(*fileName0, &w1);
    let *_3 = putStrLn(
        "This source file has the following average number of words per line:", &w1
    );
    let *_4 = print(/(fileWords(&(w1, f2)), fileLines(&(w1, f2))), &w1)
}{closeFile(*f2, &w1)}{}

// We run into call stack issues
{
    let w = 0
    avg("example.txt", ~w)
    logs()
}

[
    "This source file has the following average number of words per line:", 2
]

ir-> block{
    let *w0 = 0;
    let *_1 = avg("example.txt", &w0)
}{logs()}{}

{
    let x = 3.4 + 1.2
    x
}

4.6

ir-> block{let *x0 = +(3.4, 1.2)}{*x0}{}

fn aside(~(a, b)) ~{
    lens c <- (a + b)
    c
}

ir-> (&(a0, b1))=>block{let (&t2, r3) = heap(+(*a0, *b1))}{
    (
        &t2, ()=>block{}{null}{block{let &c4 = &t2}{*c4}{r3()}}
    )
}{}

fn useFile(name, ~w) ~{
    lens (fd, w2) <- (openFile(name, ~w), w)
    closeFile(fd)
    w := w2
}

ir-> (*name0, &w1)=>block{let (&t2, r3) = heap((openFile(*name0, &w1), *w1))}{
    (
        &t2, ()=>block{}{null}{
            block{let &(fd4, w25) = &t2}{
                block{let *_6 = closeFile(*fd4)}{swap(&w1, *w25)}{}
            }{r3()}
        }
    )
}{}

{
    let ops = []
    let text = {
        let (file, ops2) = ~useFile("example.txt", ~ops)
        readFile(~(ops2, file))
    }
    (text, ops)
}

("two\nthree four five\nsix seven height nine", [])

ir-> block{
    let *ops0 = [];
    let *text1 = block{
        let (&t4, r5) = useFile("example.txt", &ops0);
        let &(file2, ops23) = &t4
    }{readFile(&(ops23, file2))}{r5()}
}{(*text1, *ops0)}{}

/*

// --------------------
// Examples from "Capturing Types", Boruch-Gruszecki et al.
// (https://dl.acm.org/doi/pdf/10.1145/3618003)
// --------------------

// This is the usingFile combinator from "Capturing Types".
// Since this compiler targets Linear Haskell, we can't implement
// the `withFile` combinator from our paper exactly as written,
// since we have to take into account the state of the real world here.
usingFile :: String -> (~(World, Handle) -> a) -> ~World -> a
usingFile x f ~w = {
  let h = truncateFile x ~w
  let a = f ~(w, h)
  closeFile h ~w
  a
}

fileDemo :: ~World -> ()
fileDemo = usingFile "out.txt" (writeFile "Hello, world!")

goodFileUsage :: String -> ~World -> ()
