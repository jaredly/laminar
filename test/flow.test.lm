ir-> block{
    let x0 = (1, 2);
    let z1 = block{
        let (t3, c4) = fst(x0);
        let y2 = t3
    }{swap(y2, 5)}{
        swap(t3, y2);
        swap(x0, c4(t3))
    }
}{(z1, x0)}{}

