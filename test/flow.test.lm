(charList("nope"), [])

ir-> split(" ", charList("nope"))

// splitMany :: Char -> String -> List String
fn splitMany(c, xs) (
    match split(dup(~c), xs) {
        (word, []) -> {
            consume(c)
            [word]
        }
        (word, tail) -> [word, ...splitMany(c, tail)]
    }
)

ir-> (c0, xs1)=>(
    match split(block{let (r5, l6) = dup(c0)}{r5}{swap(c0, l6)}, xs1) {
        (word2, []) -> block{let _ = consume(c0)}{[word2]}{}
        (word3, tail4) -> [word3, ...splitMany(c0, tail4)]
    }
)

{splitMany(" ", charList("A B C"))}

(["A"], ["B"], ["C"])

ir-> splitMany(" ", charList("A B C"))

// words :: String -> List String
fn words(text) splitMany(" ", text)

ir-> (text0)=>splitMany(" ", text0)

// lines :: String -> List String
fn lines(text) splitMany("\n", text)

ir-> (text0)=>splitMany("\n", text0)

// fileWords :: ~(World, Handle) -> Int
fn fileWords(~(w, f)) length'(words(charList(readFile(~(w, f)))))

ir-> ((w0, f1))=>(length'(words(charList(block{let (r2, l3) = readFile((w0, f1))}{r2}{swap((w0, f1), l3)}))), (w0, f1))

// fileLines :: ~(World, Handle) -> Int
fn fileLines(~(w, f)) length'(lines(charList(readFile(~(w, f)))))

ir-> ((w0, f1))=>(length'(lines(charList(block{let (r2, l3) = readFile((w0, f1))}{r2}{swap((w0, f1), l3)}))), (w0, f1))

// avg :: ~World -> ()
fn avg(fileName, ~w) {
    let f = openFile(fileName, ~w)
    putStrLn("This source file has the following average number of words per line:", ~w)
    print(fileWords(~(w, f)) / fileLines(~(w, f)), ~w)
    closeFile(f, ~w)
}

ir-> (fileName0, w1)=>(
    block{
        let f2 = block{let (r13, l14) = openFile(fileName0, w1)}{r13}{swap(w1, l14)};
        let _ = block{let (r11, l12) = putStrLn("This source file has the following average number of words per line:", w1)}{r11}{swap(w1, l12)};
        let _ = block{let (r5, l6) = print(/(block{let (r7, l8) = fileWords((w1, f2))}{r7}{swap((w1, f2), l8)}, block{let (r9, l10) = fileLines((w1, f2))}{r9}{swap((w1, f2), l10)}), w1)}{r5}{swap(w1, l6)};
        let (r3, l4) = closeFile(f2, w1)
    }{r3}{swap(w1, l4)}, w1
)

// We run into call stack issues
{
    let w = 0
    avg("example.txt", ~w)
    logs()
}

["This source file has the following average number of words per line:", 2]

ir-> block{
    let w0 = 0;
    let _ = block{let (r1, l2) = avg("example.txt", w0)}{r1}{swap(w0, l2)}
}{logs()}{}

/*

// --------------------
// Examples from "Capturing Types", Boruch-Gruszecki et al.
// (https://dl.acm.org/doi/pdf/10.1145/3618003)
// --------------------

// This is the usingFile combinator from "Capturing Types".
// Since this compiler targets Linear Haskell, we can't implement
// the `withFile` combinator from our paper exactly as written,
// since we have to take into account the state of the real world here.
usingFile :: String -> (~(World, Handle) -> a) -> ~World -> a
usingFile x f ~w = {
  let h = truncateFile x ~w
  let a = f ~(w, h)
  closeFile h ~w
  a
}

fileDemo :: ~World -> ()
fileDemo = usingFile "out.txt" (writeFile "Hello, world!")

goodFileUsage :: String -> ~World -> ()
goodFileUsage s = usingFile "good.txt" (writeFile s)

