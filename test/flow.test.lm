/**
 * This is a translation of flow.fl to my syntax,
 * along with some basic tests of the functions
 */
// ~a means the same as a/a,
// so this has type `Int/Int -> ()`, modifying the integer it was passed in place.
inc :: (~Int) => ()
fn inc(~x) {x := x + 1}

ir-> (x0)=>(swap(x0, +(x0, 1)), x0)

{
    let x = 5
    inc(~x)
    x
}

6

ir-> block{
    let x0 = 5;
    let _ = block{let (r1, l2) = inc(x0)}{r1}{swap(x0, l2)}
}{x0}{}

fst :: ((a, b)/(a', b)) => a/a'
fn fst(~(x, y)) ~x

ir-> ((x0, y1))=>(x0, (back2)=>block{swap(x0, back2)}{(x0, y1)}{})

{
    let x = (1, 2)
    let z = {
        let y = ~fst(~x)
        y := 5
    }
    (z, x)
}

