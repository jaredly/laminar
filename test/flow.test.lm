// --------------------
// Examples from "From Linearity to Borrowing", Wagner et al.
// (https://dl.acm.org/doi/10.1145/3764117)
// --------------------
//
// First we need to establish some basic functions on lists.
// not :: Bool -> Bool
fn not(b) (
    match b {
        true -> false
        false -> true
    }
)

ir-> (b0)=>(
    match b0 {
        true -> false
        false -> true
    }
)

{not(true)}

false

ir-> not(true)

// Consumes the input.
// length' :: List String -> Int
fn length'(xs) (
    match xs {
        [] -> 0
        [y, ...ys] -> {
            drop(y)
            1 + length'(ys)
        }
    }
)

ir-> (xs0)=>(
    match xs0 {
        [] -> 0
        [y1, ...ys2] -> block{let _ = drop(y1)}{+(1, length'(ys2))}{}
    }
)

{length'([1, 2, 3])}

3

ir-> length'([1, 2, 3])

// length :: ~List a -> Int
fn length(~xs) (
    match ~xs {
        [] -> 0
        [y, ...ys] -> 1 + length(~ys)
    }
)

ir-> (xs0)=>(
    (
        match xs0 {
            [] -> block{}{0}{swap(xs0, [])}
            [y1, ...ys2] -> block{}{+(1, block{let (r3, l4) = length(ys2)}{r3}{swap(ys2, l4)})}{swap(xs0, [y1, ...ys2])}
        }
    ), xs0
)

{
    let x = [1, 2, 3]
    (length(~x), x)
}

(3, [1, 2, 3])

ir-> block{let x0 = [1, 2, 3]}{(block{let (r1, l2) = length(x0)}{r1}{swap(x0, l2)}, x0)}{}

// split :: Char -> String -> (String, String)
fn split(c, xs) (
    match xs {
        [] -> {
            consume(c)
            ([], [])
        }
        [x, ...xs] -> (
            match (dup(~x) == dup(~c)) {
                true -> {
                    consume(x)
                    consume(c)
                    ([], xs)
                }
                false -> {
                    let (y, z) = split(c, xs)
                    ([x, ...y], z)
                }
            }
        )
    }
)

ir-> (c0, xs1)=>(
    match xs1 {
        [] -> block{let _ = consume(c0)}{([], [])}{}
        [x2, ...xs3] -> (
            match ==(block{let (r6, l7) = dup(x2)}{r6}{swap(x2, l7)}, block{let (r8, l9) = dup(c0)}{r8}{swap(c0, l9)}) {
                true -> block{
                    let _ = consume(x2);
                    let _ = consume(c0)
                }{([], xs3)}{}
                false -> block{let (y4, z5) = split(c0, xs3)}{([x2, ...y4], z5)}{}
            }
        )
    }
)

