fn gimme(initial) ~{
    lens b <- initial
    drop(b)
}

ir-> (initial0)=>block{
    let t1 = initial0;
    let c2 = (b3)=>drop(b3)
}{
    (
        t1, (back4)=>block{
            swap(t1, back4);
            swap((), c2(t1))
        }{()}{}
    )
}{}

