
fn inc(~x: ~int) {
    x := x + 1
}

fn fst(~(x, y): (a, b)/(a', b)): a/'a {
    ~x
}

fn incFst(~x: ~(int, a)) {
    inc(~(fst(~x)))
}

fn idf(~a) {
    ()
}

fn idl(~x: a/b) {
    ~x
}

fn united(~x: ~a) {
    ~()
}

fn swap(~(x, y): (a,b)/(c,d)): (b,a)/(d,c) {
    ~(y, x)
}

fn united'(~x: ~a) {}

fn makeunit() {
    ~()
}

// ok so they are currying. which I can copy its fine

fn fcomp(g: (b/b') => c/c', f: (a/a') => b/b', ~x: a/a'): c/c' {
    ~g(~f(~x))
}

fn take(~a: a/()): a {
    a := ()
}

fn map(f: (a/b) => (), ~x: a/b) {
    x := f(x)
}

fn unmap(f:  (a/b) => (), x: a):  b {
    f(~x);
    x
}

fn over(f: a => b, g: c/d => a/b, x: c): d {
    map(f, ~g(~x))
    x
}
