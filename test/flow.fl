
// --------------------
// Flow functions and lens terms
// --------------------
// This section shows some basic examples of using flow typing
// to perform manipulations of linear types that would otherwise
// need to be done using explicit threading of values.
// In this language, a line break between two terms `t1` and `t2`
// means the same thing as `let () = t1 in t2`.
// --------------------

// ~a means the same as a/a,
// so this has type `Int/Int -> ()`, modifying the integer it was passed in place.
inc :: (~Int) => ()
fn inc(~x) { x := x + 1 }

{
    let x = 5
    inc(~x)
    x
}

6

fst :: ((a, b)/(a', b)) => a/a'
fn fst(~(x, y)) ~x

{
    let x = (1, 2)
    let z = {
        let y = ~fst(~x)
        y := 5
    }
    (z, x)
}

(1, (5, 2))

incFst :: (~(Int, a)) => ()
fn incFst(~x) inc(~fst(~x))

{
    let x = (1, 4)
    incFst(~x)
    x
}

(2,4)

idf :: (~a) => ()
fn idf(~x) ()

{
    let x = 2
    idf(~x)
    x
}

2

idl :: (a/b) => a/b
fn idl(~x) ~x

{
    let x = 2
    let z = {
        let m = ~idl(~x)
        m := 4
    }
    (z, x)
}

(2, 4)

united :: (~a) => ~()
fn united(~x) ~()

{
    let x = 2
    let z = {
        // x is borrowed for the duration of m,
        // but m doesn't actually do anything with it
        let m = ~united(~x)
        m := ()
    }
    (z, x)
}

((), 2)

fn gimme(initial) ~{
    lens b <- initial
    drop(b)
}

{
    let x = 2
    let z = {
        let m = ~gimme(5)
        m := ()
    }
    (z, x)
}

(5, 2)

{
    let m = ()
    let n = {
        let ok = ~{
            lens b <- 5
            m := b
        }
        ok := 10
    }
    (m, n)
}

(10, 5)

swap :: ((a,b)/(c,d)) => (b,a)/(d,c)
fn swap(~(x, y)) ~(y, x)

{
    let x = (1, 2)
    {
        // z points to a swapped version of x
        // so incrementing the first of z incs
        // the second of x
        let z = ~swap(~x)
        incFst(~z)
    }
    x
}
(1, 3)

{
    let x = (1, 2)
    {
        incFst(~swap(~x))
    }
    x
}
(1, 3)

united' :: (~a) => ()
fn united'(~x) ()

{
    let x = 1
    united'(~x)
    x
}

1

makeunit :: (()) => ~()
fn makeunit(()) ~()

{
    let x = 1
    let m = ~makeunit(())
    x
}

1

take :: (a/()) => a
fn take(~a) { a := () }

{
    let x = 1
    take(~x)
    x
}

()

map :: ((a) => b, a/b) => ()
fn map(f, ~x) { x := f(x) }

fn double(x) { x * 2 }

{
    let x = 10
    map(double, ~x)
    x
}

20

{
    fn nothing() { 4 }
    nothing()
}

4

{
    fn multi(a, b, c) { (a, b + c) }
    multi(2, 3, 4)
}

(2, 7)

unmap :: ((a/b) => (), a) => b
fn unmap(f, x) {
    f(~x)
    x
}

{
    unmap(inc, 5)
}

6

{
    let a = (1, 2)
    let m = {
        let x = ~swap(~a)
        5
    }
    (m, a)
}

(5, (1,2))


