{
    fn dropper(a) ~{
        lens b <- a
        // do normal cleanup stuff
        consume(b)
    }
    consume(1)
    let v = ~dropper(5)
    consume(2)
    consume(v := 10)
    consume(3)
    4
}

((1,2,5,3,10), 4)

{
    fn dropper(a) ~{
        lens b <- a
        // do normal cleanup stuff
        consume(b)
    }
    consume(1)
    let res = {
        let v = ~dropper(5)
        consume(v := 10)
        4
    }
    // v exits scope, so cleanup happens
    consume(3)
    res
}

