/**
 * This is a translation of flow.fl to my syntax,
 * along with some basic tests of the functions
 */
// ~a means the same as a/a,
// so this has type `Int/Int -> ()`, modifying the integer it was passed in place.
inc :: (~Int) => ()
fn inc(~x) {x := x + 1}

ir-> (x0)=>(swap(x0, +(x0, 1)), x0)

{
    let x = 5
    inc(~x)
    x
}

6

ir-> iffe{
    let x0 = 5;
    let _ = iffe{let (r1, l2) = inc(x0)}{r1}{swap(x0, l2)}
}{x0}{}

fst :: ((a, b)/(a', b)) => a/a'
fn fst(~(x, y)) ~x

ir-> ((x0, y1))=>(x0, (back2)=>iffe{swap(x0, back2)}{(x0, y1)}{})

{
    let x = (1, 2)
    let z = {
        let y = ~fst(~x)
        y := 5
    }
    (z, x)
}

(1, (5, 2))

ir-> iffe{
    let x0 = (1, 2);
    let z1 = iffe{
        let (t3, c4) = fst(x0);
        let y2 = t3
    }{swap(y2, 5)}{
        swap(t3, y2);
        swap(x0, c4(t3))
    }
}{(z1, x0)}{}

incFst :: (~(Int, a)) => ()
fn incFst(~x) inc(~fst(~x))

ir-> (x0)=>(
    iffe{
        let (t1, c2) = fst(x0);
        let (r3, l4) = inc(t1)
    }{r3}{
        swap(t1, l4);
        swap(x0, c2(t1))
    }, x0
)

{
    let x = (1, 4)
    incFst(~x)
    x
}

(2, 4)

ir-> iffe{
    let x0 = (1, 4);
    let _ = iffe{let (r1, l2) = incFst(x0)}{r1}{swap(x0, l2)}
}{x0}{}

idf :: (~a) => ()
fn idf(~x) ()

ir-> (x0)=>((), x0)

{
    let x = 2
    idf(~x)
    x
}

2

ir-> iffe{
    let x0 = 2;
    let _ = iffe{let (r1, l2) = idf(x0)}{r1}{swap(x0, l2)}
}{x0}{}

idl :: (a/b) => a/b
fn idl(~x) ~x

ir-> (x0)=>(x0, (back1)=>iffe{swap(x0, back1)}{x0}{})

{
    let x = 2
    let z = {
        let m = ~idl(~x)
        m := 4
    }
    (z, x)
}

(2, 4)

ir-> iffe{
    let x0 = 2;
    let z1 = iffe{
        let (t3, c4) = idl(x0);
        let m2 = t3
    }{swap(m2, 4)}{
        swap(t3, m2);
        swap(x0, c4(t3))
    }
}{(z1, x0)}{}

united :: (~a) => ~()
fn united(~x) ~()

ir-> (x0)=>((), (back1)=>iffe{swap((), back1)}{x0}{})

{
    let x = 2
    let z = {
        let m = ~united(~x)
        m := ()
    }
    (z, x)
}

((), 2)

ir-> iffe{
    let x0 = 2;
    let z1 = iffe{
        let (t3, c4) = united(x0);
        let m2 = t3
    }{swap(m2, ())}{
        swap(t3, m2);
        swap(x0, c4(t3))
    }
}{(z1, x0)}{}

fn gimme(initial) ~{
    lens b <- initial
    drop(b)
}

ir-> (initial0)=>iffe{
    let t1 = initial0;
    let c2 = (b3)=>drop(b3)
}{
    (
        t1, (back4)=>iffe{
            swap(t1, back4);
            swap((), c2(t1))
        }{()}{}
    )
}{}

{
    let x = 2
    let z = {
        let m = ~gimme(5)
        m := ()
    }
    (z, x)
}

(5, 2)

ir-> iffe{
    let x0 = 2;
    let z1 = iffe{
        let (t3, c4) = gimme(5);
        let m2 = t3
    }{swap(m2, ())}{
        swap(t3, m2);
        swap((), c4(t3))
    }
}{(z1, x0)}{}

